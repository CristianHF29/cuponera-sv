# La Cuponera SV
# Todo lo que no sea un archivo real (CSS, JS, imágenes) lo atiende index.php

Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # La carpeta de git no se publica
    RewriteRule ^\.git - [F,L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>
